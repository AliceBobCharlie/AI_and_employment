# Data: raw downloads and the tables built from them. All of it is public or
# rebuilt by data_prep/; the sources are listed in README.MD.
data/

# Reference material kept locally.
reference/

# Results: rebuilt by the scripts. Only the files the paper reads are tracked,
# because no Python runs when the paper is built.
output/**
!output/**/
!output/pca_rotated/occupation_coordinates.csv
!output/pca_rotated/axis_loadings.csv
!output/resampling_stability/subspace_stability.png
!output/acs_young_share/acs_young_share.csv

# Build and editor files. The last two Quarto lines are the exact form Quarto
# checks for; with them here it does not append them on every render.
_site/
__pycache__/
.ipynb_checkpoints/
.DS_Store
.idea/
reports/
.quarto/
/.quarto/
**/*.quarto_ipynb
