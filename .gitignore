# Whitelist .gitignore -- ignore everything, then allow only what should ship.
# New notes and drafts stay untracked by default, which is the point: nothing
# reaches the remote unless it is named here.

# 1. ignore every file
*

# 2. but let git descend into directories, so the rules below can match inside
!*/

# 3. scripts and documents
!.gitignore
!README.md
!paper_draft.md
!index.html
!*.py

# 4. raw data: never committed -- large, and all of it is publicly downloadable.
#    Ship the download instructions instead.
data_raw/*
!data_raw/README.md

# 5. output: the analysis-ready table and the two figures, nothing else.
#    master_clean.xlsx is the single input every analysis script reads, so with
#    it alone a reader can reproduce the axes without rebuilding from source.
#    Everything else here is regenerated by running the scripts.
output/*
!output/master_clean.xlsx
!output/fig_3d_space.html
!output/fig_panels.html
!output/master_wide.xlsx


# 6. junk
__pycache__/
.ipynb_checkpoints/
.DS_Store
reports/
.idea/